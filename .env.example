# =============================================================================
#  BetDoc — Secret Overlay
#  Copy to `.env` and fill in. `.env` is gitignored; this template is not.
#  config.yaml references these via ${VAR} / ${VAR:-default} interpolation.
#  Rule: config.yaml holds SHAPE, .env holds SECRETS. Never invert this.
# =============================================================================

# ---- Runtime ----------------------------------------------------------------
BETDOC_ENV=development                  # development | staging | production
BETDOC_LOG_LEVEL=INFO

# ---- PostgreSQL (historical odds, bet ledger, CLV panel) --------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=betdoc
POSTGRES_USER=betdoc
POSTGRES_PASSWORD=change-me-before-first-run

# ---- Redis (live market state, sub-millisecond reads) ----------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ---- Authorized feed credentials -------------------------------------------
# Betfair Exchange API — free app key, register at developer.betfair.com
BETFAIR_APP_KEY=
BETFAIR_USERNAME=
BETFAIR_PASSWORD=
BETFAIR_CERT_PATH=./secrets/betfair-client.crt
BETFAIR_KEY_PATH=./secrets/betfair-client.key

# The Odds API — free tier, 500 req/month, the-odds-api.com
THE_ODDS_API_KEY=

# Pinnacle — sharp reference book, account required
PINNACLE_USERNAME=
PINNACLE_PASSWORD=

# ---- API surface ------------------------------------------------------------
# Dashboard is UNAUTHENTICATED by default and binds to loopback only.
# Set a token AND flip api.auth.enabled in config.yaml before any non-local bind.
BETDOC_API_TOKEN=
