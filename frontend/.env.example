# ---------------------------------------------------------------------------
# WARNING: every VITE_* value is compiled into the PUBLIC JavaScript bundle.
# Anything placed in a *_KEY variable is visible to every visitor.
# Recommended: point the Omni URLs at a BetDoc backend proxy that holds the
# real provider keys server-side, and leave the *_KEY variables EMPTY.
# ---------------------------------------------------------------------------

# Core API (Groups 58-59)
VITE_API_BASE_URL=/api
VITE_WS_BASE_URL=/api/ws
VITE_APP_ENV=production
VITE_API_TIMEOUT_MS=15000
VITE_API_WITH_CREDENTIALS=false
VITE_SW_UPDATE_INTERVAL_MS=3600000
VITE_MAX_ODDS_ENTRIES=5000

# Omni-Gateway: REST layer
VITE_OMNI_REST_URL=
VITE_OMNI_REST_KEY=
# header | bearer | query
VITE_OMNI_REST_AUTH_MODE=header
# Header name (header mode) or query parameter name (query mode)
VITE_OMNI_REST_AUTH_PARAM=X-API-Key
VITE_OMNI_REST_TIMEOUT_MS=15000
VITE_OMNI_REST_MAX_RETRIES=2
VITE_OMNI_REST_RETRY_BASE_MS=500
VITE_OMNI_REST_RETRY_MAX_MS=8000

# Omni-Gateway: WebSocket layer
VITE_OMNI_WS_URL=
VITE_OMNI_WS_KEY=
# query | message | protocol
VITE_OMNI_WS_AUTH_MODE=query
VITE_OMNI_WS_AUTH_PARAM=apiKey
# JSON field used to route incoming messages to subscribers
VITE_OMNI_WS_TOPIC_FIELD=topic
# 0 disables heartbeat; payload is sent verbatim
VITE_OMNI_WS_HEARTBEAT_MS=0
VITE_OMNI_WS_HEARTBEAT_PAYLOAD=
VITE_OMNI_WS_MAX_RECONNECT_ATTEMPTS=12
VITE_OMNI_WS_RECONNECT_BASE_MS=1000
VITE_OMNI_WS_RECONNECT_MAX_MS=30000
